# Copy to /etc/adust-it-portal.env and fill in. Never commit the real file.

# Long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
PORTAL_SECRET_KEY=change-me

# University networks allowed to open the portal (comma-separated IPs/CIDRs).
# You can also manage these from Admin → Network access in the portal.
PORTAL_ALLOWED_NETWORKS=192.168.0.0/16,10.0.0.0/8

# Set to 1 when running behind nginx (see nginx.conf) so the real client IP is used.
PORTAL_TRUST_PROXY=1
# Set to 1 once the site is served over HTTPS.
PORTAL_HTTPS=0

PORTAL_DATABASE=/var/lib/adust-it-portal/portal.db
PORTAL_UPLOADS=/var/lib/adust-it-portal/uploads
PORTAL_BACKUPS=/var/lib/adust-it-portal/backups
# Which emails may register. Empty = ANY email (Gmail, Yahoo, .edu, ...).
# Example to allow only some domains: PORTAL_ALLOWED_EMAIL_DOMAINS=adust.edu.bd,gmail.com
PORTAL_ALLOWED_EMAIL_DOMAINS=
# Used in links inside emails (password reset, notifications)
PORTAL_BASE_URL=http://it-portal.adust.edu.bd

# OPTIONAL — sign in with the university webmail password (IMAP over SSL).
# Disabled for now; uncomment these three lines to turn it on later.
# PORTAL_EMAIL_DOMAIN=adust.edu.bd
# PORTAL_IMAP_HOST=mail.adust.edu.bd
# PORTAL_IMAP_PORT=993

# Email notifications + password reset (SMTP). Leave SMTP_HOST empty to disable email.
# Any mail account can send, e.g. a Gmail account with an "App password":
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=adust.it.portal@gmail.com  SMTP_PASSWORD=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ADUST IT Section <your-sending-address@example.com>

# SMS for urgent requests (any HTTP SMS gateway). {phone} and {message} are filled in.
# Example (BulkSMSBD):
# SMS_API_URL=http://bulksmsbd.net/api/smsapi?api_key=YOUR_KEY&type=text&senderid=YOUR_SENDER_ID&number={phone}&message={message}
SMS_API_URL=
SMS_METHOD=GET
# Numbers like 017xxxxxxxx become 88017xxxxxxxx
SMS_COUNTRY_PREFIX=88
