# Copy to /etc/adust-it-portal.env and fill in. Never commit the real file.

# Long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
PORTAL_SECRET_KEY=change-me

# University networks allowed to open the portal (comma-separated IPs/CIDRs).
# You can also manage these from Admin → Network in the portal.
PORTAL_ALLOWED_NETWORKS=192.168.0.0/16,10.0.0.0/8

# Set to 1 when running behind nginx (see nginx.conf) so the real client IP is used.
PORTAL_TRUST_PROXY=1
# Set to 1 once the site is served over HTTPS.
PORTAL_HTTPS=0

PORTAL_DATABASE=/var/lib/adust-it-portal/portal.db
PORTAL_UPLOADS=/var/lib/adust-it-portal/uploads
PORTAL_EMAIL_DOMAIN=adust.edu.bd
PORTAL_BASE_URL=http://it-portal.adust.edu.bd

# Sign in with university webmail password (IMAP over SSL). Leave empty to disable.
PORTAL_IMAP_HOST=mail.adust.edu.bd
PORTAL_IMAP_PORT=993

# Email notifications (SMTP). Leave SMTP_HOST empty to disable email.
SMTP_HOST=mail.adust.edu.bd
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=it-portal@adust.edu.bd
SMTP_PASSWORD=
SMTP_FROM=ADUST IT Section <it-portal@adust.edu.bd>
